        {
            "language": "javascript",
            "source": [
                "const fs = require(\"fs\");\n\nclass GameData {\n    constructor() {\n        this.id = 0;\n        this.title = \"\";\n        this.genre = \"\";\n        this.platform = \"\";\n        this.releaseYear = 0;\n        this.myPrice = 0;\n        this.fullPrice = 0;\n        this.rating = 0;\n        this.myRating = 0;\n        this.isDone = false;\n        this.multiplayer = false;\n        this.publisher = \"\";\n    }\n}\n\nconst game1 = new GameData();\ngame1.id = 1;\ngame1.title = \"Need For Speed Unbound\";\ngame1.genre = \"Racing\";\ngame1.platform = \"Steam\";\ngame1.releaseYear = 2022;\ngame1.myPrice = 79.99;\ngame1.fullPrice = 299.90;\ngame1.rating = 6;\ngame1.myRating = 8;\ngame1.isDone = false;\ngame1.multiplayer = true;\ngame1.publisher = \"Criterion Games\";\n\nconst game2 = new GameData();\ngame2.id = 2;\ngame2.title = \"Geometry Dash\";\ngame2.genre = \"Rhythm Game\";\ngame2.platform = \"Steam\";\ngame2.releaseYear = 2014;\ngame2.myPrice = 19.99;\ngame2.fullPrice = 19.99;\ngame2.rating = 9;\ngame2.myRating = 6;\ngame2.isDone = false;\ngame2.multiplayer = false;\ngame2.publisher = \"RobTop Games\";\n\nconst game3 = new GameData();\ngame3.id = 3;\ngame3.title = \"Hogwarts Legacy\";\ngame3.genre = \"RPG\";\ngame3.platform = \"Epic Games\";\ngame3.releaseYear = 2023;\ngame3.myPrice = 0;\ngame3.fullPrice = 269;\ngame3.rating = 9;\ngame3.myRating = 9;\ngame3.isDone = false;\ngame3.multiplayer = false;\ngame3.publisher = \"Warner Bros. Games\";\n\nconst game4 = new GameData();\ngame4.id = 4;\ngame4.title = \"Among us\";\ngame4.genre = \"SurvivalRPG\";\ngame4.platform = \"Steam\";\ngame4.releaseYear = 2018;\ngame4.myPrice = 18.99;\ngame4.fullPrice = 18.99;\ngame4.rating = 9;\ngame4.myRating = 8;\ngame4.isDone = false;\ngame4.multiplayer = true;\ngame4.publisher = \"Innersloth\";\n\nfunction calculateNextId() {\n    let filepath = \"./ids.txt\";\n    let stringData = fs.readFileSync(filepath, \"utf8\");\n    let ids = JSON.parse(stringData);\n    ids.sort((a, b) => a - b);\n    let q = ids[ids.length - 1];\n    return q + 1;\n}\n\nconst gameList = [game1, game2, game3, game4];\n\nfunction addGame() {\n    const game = new GameData();\n    const id = calculateNextId();\n    game.id = id;\n    gameList.push(game);\n    let filepath = \"./ids.txt\";\n    const usedIds = fs.readFileSync(filepath, \"utf8\");\n    const ids = JSON.parse(usedIds);\n    ids.push(id);\n    let saving = JSON.stringify(ids);\n    fs.writeFileSync(filepath, saving);\n}\n\naddGame();\n\ngameList;"
            ],
            "outputs": []
        },
        {
            "language": "javascript",
            "source": [
                "function findGameByID(gameArr, id){\n    for(let i = 0; i<gameArr.length; i++){\n        let game = gameArr[i]\n        if(game.id == id){\n            return game\n        }\n    }\n}\n\nfunction findGamesByIDs(gameArr, idArr){\n    const findedGames = []\n    for(let i = 0; i<idArr.length; i++){\n        let id = idArr[i]\n        let game = findGameByID(gameArr, id)\n        findedGames.push(game)\n    }\n    return findedGames \n}\n\nfunction loadGamesData(){\n    let filePath = \"./dane.txt\";\n    const stringData = fs.readFileSync(filePath, \"utf8\");\n    const data = JSON.parse(stringData)\n    return data;\n}\n\nfunction saveGamesData(gameList){\n    let filePath = \"./dane.txt\";\n    let jsonData = JSON.stringify(gameList)\n    fs.writeFileSync(filePath, jsonData, \"utf8\");\n}\n\n\nfunction saveGameQueue(gameQueue){\n    let filePath = \"./gameQueue.txt\";\n    let ids = []\n    for(let j = 0; j<gameQueue.length; j++){\n        let queue = gameQueue[j]\n        ids.push(queue.id)\n    }\n    let jsonData = JSON.stringify(ids)\n    fs.writeFileSync(filePath, jsonData, \"utf8\");\n}\n\nfunction loadGameQueue(){\n    let filePath = \"./gameQueue.txt\";\n    const stringData = fs.readFileSync(filePath, \"utf8\");\n    const gameIDs = JSON.parse(stringData)\n    let allGames = loadGamesData()\n    return findGamesByIDs(allGames, gameIDs)\n}\n\n\n\n\n\n\n\n\n\n\n\nsaveGamesData(gameList)\nloadGamesData();\nconst myQueue = [game1, game4, game3]\nmyQueue\nsaveGameQueue(myQueue)\nloadGameQueue()\n"
            ],
            "outputs": []
        }
