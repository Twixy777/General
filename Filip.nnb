            "language": "javascript",
            "source": [
                "const fs = require(\"fs\");\n\nfunction loadGamesData(){\n    let filePath = \"./dane.txt\";\n    const stringData = fs.readFileSync(filePath, \"utf8\");\n    const data = JSON.parse(stringData)\n    return data;\n}\n\nfunction saveGamesData(gameList){\n    let filePath = \"./dane.txt\";\n    let jsonData = JSON.stringify(gameList)\n    fs.writeFileSync(filePath, jsonData, \"utf8\");\n}\n\n\nfunction saveGameQueue(gameQueue){\n    let filePath = \"./gameQueue.txt\";\n    let jsonData = JSON.stringify(gameQueue)\n    fs.writeFileSync(filePath, jsonData, \"utf8\");\n}\n\nfunction loadGameQueue(){\n    let filePath = \"./gameQueue.txt\";\n    const stringData = fs.readFileSync(filePath, \"utf8\");\n    const data = JSON.parse(stringData)\n    return data;\n}\n\nsaveGamesData(gameList)\nloadGamesData();\nconst myQueue = [game1, game4, game3]\nmyQueue\nsaveGameQueue(myQueue)\nloadGameQueue()"
            ],
